{
  "name": "horizon-launcher",
  "version": "2.0.0",
  "description": "Horizon Minecraft Launcher - Complete Package",
  "private": true,
  "scripts": {
    "start": "node start.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:api": "cd api-server && npm start",
    "dev:ui": "cd horizon-ui && npm run dev",
    "dev:electron": "wait-on http://localhost:3000 http://localhost:5173 && cd electron-launcher && npm run dev",
    "install:all": "npm run install:api && npm run install:ui && npm run install:electron",
    "install:api": "cd api-server && npm install",
    "install:ui": "cd horizon-ui && npm install",
    "install:electron": "cd electron-launcher && npm install",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "horizon"
  ],
  "author": "Horizon Team",
  "license": "MIT",
  "dependencies": {
    "rss-parser": "^3.13.0",
    "skinview3d": "^3.4.1"
  }
}
