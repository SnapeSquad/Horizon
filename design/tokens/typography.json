{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Типографика из Figma",
  "fontFamily": {
    "primary": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif",
    "monospace": "'SF Mono', 'Monaco', 'Consolas', monospace",
    "description": "Семейства шрифтов"
  },
  "fontSizes": {
    "xs": "12px",
    "sm": "13px",
    "base": "14px",
    "md": "16px",
    "lg": "18px",
    "xl": "20px",
    "2xl": "22px",
    "3xl": "24px",
    "4xl": "32px",
    "description": "Размеры шрифтов"
  },
  "fontWeights": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "description": "Насыщенность шрифтов"
  },
  "lineHeights": {
    "tight": 1.2,
    "normal": 1.5,
    "relaxed": 1.75,
    "description": "Межстрочные интервалы"
  },
  "textStyles": {
    "title": {
      "fontSize": "32px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "color": "#ffffff"
    },
    "subtitle": {
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "color": "rgba(255, 255, 255, 0.9)"
    },
    "body": {
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "color": "rgba(255, 255, 255, 0.8)"
    },
    "button": {
      "fontSize": "16px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "color": "#ffffff"
    },
    "caption": {
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "color": "rgba(255, 255, 255, 0.6)"
    }
  }
}

