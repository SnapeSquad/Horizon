# API server port
PORT=3000

# Token for admin endpoints
ADMIN_TOKEN=change_me_admin_token

# Optional admin account bootstrap (for JWT admin login in panel)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT signing key
JWT_SECRET=change_me_jwt_secret

# Telegram bot token (optional in local smoke/test)
TELEGRAM_BOT_TOKEN=

# Optional custom telegram deep link base for payment generation
# Example: https://t.me/your_bot?start=
TELEGRAM_BOT_URL=
